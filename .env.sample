# Repository-level Docker Compose defaults. Copy to `.env` at the repository
# root only when you want an explicit, editable local port map:
#   cp .env.sample .env
#
# Native processes use 46000-46010. Docker reuses the same browser-facing
# ports; the Docker VPC origins use 46104-46107 so they can run beside the
# native RPC processes started by `mise run dev`.
DAPP_HOST_PORT=46000
ADMIN_HOST_PORT=46001
LANDING_HOST_PORT=46002
API_GATEWAY_HOST_PORT=46003
TRADING_RPC_HTTP_HOST_PORT=46104
TRADING_RPC_GRPC_HOST_PORT=46105
ADMIN_RPC_HTTP_HOST_PORT=46106
ADMIN_RPC_GRPC_HOST_PORT=46107
POSTGRES_HOST_PORT=46008
STAGING_DAPP_HOST_PORT=46200

# Local-only PostgreSQL credentials used by the development Compose overlay.
POSTGRES_DB=trading_rpc
POSTGRES_USER=trading_rpc
POSTGRES_PASSWORD=trading_rpc_local
