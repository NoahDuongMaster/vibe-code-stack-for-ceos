# Sentry DSN for the Astro landing app. Leave empty to disable Sentry.
# When set, astro.config.ts wires the @sentry/astro integration (client-side
# error monitoring). Source-map upload is disabled, so no auth token is needed.
# Note: setting this turns the otherwise zero-JS landing page into a
# JS-shipping page — enable deliberately.
PUBLIC_SENTRY_DSN=

# Local URL used for canonical URLs, OpenGraph tags, robots.txt and the sitemap.
# Replace it with the real public origin in staging/production.
PUBLIC_SITE_URL=http://localhost:46002
