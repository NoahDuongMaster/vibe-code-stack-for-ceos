{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-first-landing",
  "compatibility_date": "2026-06-21",
  // Static-only Worker: serve Astro's build output (dist/) as assets.
  "assets": { "directory": "./dist" },
  "observability": {
    "enabled": true
  },
  // Pin CI/CD to `--env staging` / `--env production` explicitly. Rollback:
  // `wrangler rollback --env production`.
  "env": {
    "staging": {
      "name": "vibe-code-stack-for-ceos-staging"
    },
    "production": {
      "name": "vibe-code-stack-for-ceos",
      // Production is reachable only through the canonical Custom Domain.
      // Disable both the stable workers.dev URL and per-version Preview URLs.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "vibe-code-stack-for-ceos.duongnamtruong.com",
          "custom_domain": true
        }
      ]
    }
  }
}
