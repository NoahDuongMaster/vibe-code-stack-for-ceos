# Complete local-development defaults — safe to commit. Start with:
#   cp apps/dapp/.env.sample apps/dapp/.env
# Use `.env.development.local` only for machine-specific secret overrides.

# --- Public (client-safe) ---
NEXT_PUBLIC_PROJECT_NAME="vibe-code-stack-for-ceos"
NEXT_PUBLIC_API_ENDPOINT=http://localhost:46003
NEXT_PUBLIC_BASE_URL=http://localhost:46000
NEXT_PUBLIC_CORS_COOKIE=localhost
# Set to any non-empty value to enable extra client-side debug logging.
NEXT_PUBLIC_DEBUG=

# Sentry (optional in dev)
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time (next.config.ts) — leave
# unset locally. Also requires a SENTRY_AUTH_TOKEN in the deploy environment.
SENTRY_ORG=
SENTRY_PROJECT=

# --- Server-only ---
# Dev-only placeholder — the app REFUSES to start with this exact value when
# NODE_ENV=production (see src/entities/session/api/session.server.ts). Generate a real secret
# for any real deploy: `openssl rand -base64 48`.
SESSION_SECRET=dev-session-secret-min-32-chars!!

# Reference credentials for the dapp login flow. Replace the verifier in
# src/features/sign-in/model/verify-credentials.server.ts when wiring an IdP.
DEMO_AUTH_EMAIL=admin@example.com
DEMO_AUTH_PASSWORD=change-me-please
# Standalone local/CI servers do not have Cloudflare Durable Object bindings.
# Cloudflare staging/production override this to `distributed` in wrangler.jsonc.
DAPP_LOGIN_RATE_LIMIT_MODE=local

CORS_ORIGINS=*.localhost:46000,localhost:46000
CORS_RESOURCE=
