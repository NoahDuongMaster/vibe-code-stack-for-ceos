{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-first-dapp",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // `wrangler deploy` with no --env uses this top-level config; pin CI/CD to
  // `--env staging` / `--env production` explicitly so a name typo can never
  // land on the wrong Worker. Distinct names avoid collisions on a shared
  // Cloudflare account. Rollback: `wrangler rollback --env production`.
  "env": {
    "staging": {
      "name": "ai-first-dapp-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "DAPP_LOGIN_RATE_LIMIT_MODE": "distributed"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "LOGIN_RATE_LIMITER",
            "class_name": "RateLimiterDO",
            "script_name": "ai-gateway-staging"
          }
        ]
      }
    },
    "production": {
      "name": "ai-first-dapp",
      "vars": {
        "ENVIRONMENT": "production",
        "DAPP_LOGIN_RATE_LIMIT_MODE": "distributed"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "LOGIN_RATE_LIMITER",
            "class_name": "RateLimiterDO",
            "script_name": "api-gateway-production"
          }
        ]
      }
    }
  }
}
