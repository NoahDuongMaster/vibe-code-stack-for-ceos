# admin-rpc (NestJS + Fastify + Connect + native gRPC) — copy to `.env`.
# `.env` is git-ignored; this sample is safe to commit.

# Required logical identity used by health responses, logs, and telemetry.
SERVICE_NAME=admin-rpc

# Public/admin Connect listener and Node-to-Node native gRPC listener.
PORT=3004
GRPC_PORT=50053

# Native gRPC endpoint owned by trading-rpc. Docker Compose overrides this with
# its private service DNS name; host development uses trading-rpc port 50051.
TRADING_RPC_GRPC_URL=http://127.0.0.1:50051
TRADING_RPC_TIMEOUT_MS=5000

# Connect defaults to HTTP/1.1. Override only for direct HTTP/2 testing.
# RPC_TRANSPORT=http2

# Comma-separated browser origins. '*' permits every origin.
CORS_ORIGINS=

MAX_BODY_BYTES=5242880
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT=300
RATE_LIMIT_WINDOW_MS=60000

# Unset disables Sentry.
SENTRY_DSN=
