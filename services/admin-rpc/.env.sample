# admin-rpc (NestJS + Fastify + Connect + native gRPC) — copy to `.env`.
# `.env` is git-ignored; this sample is safe to commit.

# Required logical identity used by health responses, logs, and telemetry.
SERVICE_NAME=admin-rpc

# Public/admin Connect listener and Node-to-Node native gRPC listener.
PORT=46006
GRPC_PORT=46007

# Native gRPC endpoint owned by trading-rpc. Docker Compose overrides this with
# its private service DNS name; host development uses trading-rpc port 46005.
TRADING_RPC_GRPC_URL=http://127.0.0.1:46005
TRADING_RPC_TIMEOUT_MS=5000

# Required server-side admin login credentials and shared HMAC signing secret.
# Replace all three values outside local development. JWT_SECRET must match the
# api-gateway secret for the same environment and contain at least 32 chars.
ADMIN_AUTH_EMAIL=admin@example.com
ADMIN_AUTH_PASSWORD=local-admin-password
JWT_SECRET=local-jwt-secret-at-least-32-characters
JWT_TTL_SECONDS=28800
# Production containers use ADMIN_AUTH_EMAIL_FILE,
# ADMIN_AUTH_PASSWORD_FILE, and JWT_SECRET_FILE instead of inline values.

# Connect defaults to HTTP/1.1. Override only for direct HTTP/2 testing.
# RPC_TRANSPORT=http2

# Comma-separated browser origins. '*' permits every origin.
CORS_ORIGINS=

MAX_BODY_BYTES=5242880
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT=300
RATE_LIMIT_WINDOW_MS=60000

# Unset disables Sentry.
SENTRY_DSN=
# Production containers may use SENTRY_DSN_FILE instead.
