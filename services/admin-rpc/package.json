{
  "name": "@services/admin-rpc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup && tsx scripts/copy-proto-assets.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci . && pnpm lint:architecture",
    "lint:architecture": "tsx scripts/check-architecture.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-fastify": "2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "11.1.0",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/microservices": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@packages/api-core": "workspace:*",
    "@packages/protocol": "workspace:*",
    "@sentry/node": "^10.64.0",
    "fastify": "5.10.0",
    "jose": "6.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
