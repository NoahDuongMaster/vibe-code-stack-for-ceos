# trading-rpc (NestJS + Fastify + Connect + native gRPC) — copy to `.env`.
# `.env` is git-ignored; this sample is safe to commit.

# Required logical application identity used by health responses, structured
# startup logs, and telemetry. Production code provides no fallback.
SERVICE_NAME=trading-rpc

# Required PostgreSQL connection used by Nest bootstrap and Drizzle Kit. This
# host value is for running trading-rpc directly on the host; Compose overrides
# the host with Docker DNS `postgres`.
DATABASE_URL=postgresql://trading_rpc:trading_rpc_local@127.0.0.1:5433/trading_rpc

# One bounded pool is created per service process. Size the total across all
# replicas below the database's connection budget.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Edge/private Connect listener used by the Cloudflare gateway (default: 3001).
PORT=3001

# Native Nest gRPC listener used by Node microservices (default: 50051).
GRPC_PORT=50051

# Connect defaults to HTTP/1.1 in every environment because the Cloudflare VPC
# Service binding calls it through Fetch. Native gRPC uses GRPC_PORT instead.
# Override only for direct Connect-managed gRPC testing: http1 or http2.
# RPC_TRANSPORT=http2

# Free Demo API key from the CoinGecko Developer Dashboard. Recommended for
# reliable live-data quota; never commit this value.
COINGECKO_API_KEY=

# Comma-separated list of allowed CORS origins for browser clients (e.g. the
# admin SPA). '*' allows any origin. Leave unset to disable CORS entirely.
# Defense-in-depth only when reached via services/api-gateway — the gateway
# re-stamps every proxied response with ITS OWN CORS_ORIGINS decision
# (overriding whatever this service sends), so it is the single CORS
# authority for browser clients. This only matters if trading-rpc is ever
# exposed directly (bypassing the gateway).
CORS_ORIGINS=

# Rejects requests whose Content-Length exceeds this many bytes (default: 5 MB).
MAX_BODY_BYTES=5242880

# Socket idle timeout in ms (default: 30000).
REQUEST_TIMEOUT_MS=30000

# Best-effort per-instance rate limit (requests per client per window) — see
# src/rate-limit.ts. Defense-in-depth only; the real limit should be enforced
# in front of this service (services/api-gateway's RATE_LIMITER binding, or a
# LB/WAF), since this does not coordinate across replicas.
RATE_LIMIT=300
RATE_LIMIT_WINDOW_MS=60000

# Sentry DSN for crash reporting. Unset disables Sentry entirely.
SENTRY_DSN=
