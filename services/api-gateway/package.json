{
  "name": "@services/api-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=development vite",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci . && pnpm lint:architecture",
    "lint:architecture": "tsx scripts/check-architecture.ts",
    "test": "vitest run && pnpm test:architecture",
    "test:architecture": "tsx --test scripts/check-architecture.test.ts"
  },
  "dependencies": {
    "@packages/api-core": "workspace:*",
    "hono": "4.12.28",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.42.1",
    "@cloudflare/workers-types": "4.20260621.1",
    "@types/node": "^26.0.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vite": "8.0.16",
    "vitest": "catalog:",
    "wrangler": "4.103.0"
  }
}
